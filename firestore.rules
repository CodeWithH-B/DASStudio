rules_version = '2';

/* ==========================================================================
   DAS Studio — Firestore security rules
   ==========================================================================
   Replace the rules in Firebase console > Firestore > Rules with this file
   (or deploy with:  firebase deploy --only firestore:rules).

   Why this shape:

   * Admin rights are decided by a CUSTOM CLAIM, not by a uid written in the
     source. The old template shipped
         request.auth.uid == 'PASTE_YOUR_ADMIN_UID'
     which, left unreplaced, matched nobody and was usually "fixed" by pasting
     the real uid into a file every visitor downloads. Instead:

         admin.auth().setCustomUserClaims('<YOUR_UID>', { admin: true });

     run once from a trusted machine / Cloud Function. The uid stays in the
     Firebase console and in that one command — never in client code.

   * A /admins/{uid} document is accepted as a second, revocable route to the
     same rights (delete the document to revoke).

   * Public collections are read-only for visitors, writable by admins.

   * feedback and analytics_events accept creates from anyone (that is the
     point) but validate shape and size, so the collection cannot be used as
     free storage or as a script injection vector.
   ========================================================================== */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- helpers ---------- */
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    /* only the fields we expect, and nothing oversized */
    function onlyFields(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    function smallString(field, max) {
      return request.resource.data[field] is string
             && request.resource.data[field].size() <= max;
    }

    /* ---------- A5: fresh sign-in for sensitive writes ----------
       A stolen ID token (or an injected script holding the live session) can
       write as the admin until the token expires — one hour by default.
       auth_time is stamped by Firebase at sign-in and is NOT refreshed by
       getIdToken(true), so this is a real re-authentication window rather than
       a token-age check.

       window: 5 minutes, as requested. Consequence: an admin who has been
       sitting in the panel for longer than that must sign out and back in
       before tools/settings/code will save. Relax it by changing the argument
       in the matches below (e.g. freshAuth(60)); the helper takes minutes. */
    function freshAuth(minutes) {
      return signedIn()
             && request.auth.token.auth_time is int
             && request.time.toMillis() < (request.auth.token.auth_time * 1000 + minutes * 60000);
    }

    /* ---------- admin roster ---------- */
    /* Readable by a signed-in user (so the app can show its own role) and
       writable by admins only. Bootstrap the first admin from the console. */
    match /admins/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin() && freshAuth(5);
    }

    /* ---------- public site data ---------- */
    match /tools/{id} {
      allow read: if true;
      allow write: if isAdmin() && freshAuth(5);
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin() && freshAuth(5);
    }

    match /media/{id} {
      allow read: if true;
      allow write: if isAdmin() && freshAuth(5);
    }

    /* ---------- custom head/body code ----------
       Readable by everyone: visitors must receive the admin's snippet.
       Writable only by an admin with a recent sign-in. This is why the client
       no longer keeps the snippet in localStorage — here it cannot be edited by
       a visitor, and here the rules can check who is writing. */
    match /code/{id} {
      allow read: if true;
      allow write: if isAdmin() && freshAuth(5);
    }

    /* ---------- visitor submissions ---------- */
    match /feedback/{id} {
      allow create: if isAdmin() || (onlyFields([
                        'ticket', 'type', 'name', 'email', 'message',
                        'status', 'createdAt', 'priority', 'attachment',
                        'assignedTo', 'page', 'ua'
                      ])
                    && smallString('message', 5000)
                    && smallString('name', 120)
                    && smallString('email', 200)
                    && smallString('ticket', 40)
                    && request.resource.data.createdAt is int);
      allow read, update, delete: if isAdmin();
    }

    match /analytics_events/{id} {
      /* a visitor may only append an event, never read the stream back */
      allow create: if isAdmin() || (onlyFields([
                        't', 'type', 'vid', 'sid', 'path', 'ref', 'dev',
                        'src', 'tool', 'dur'
                      ])
                    && request.resource.data.t is int
                    /* A5: an event is only valid if it claims "now". A script
                       replaying a captured payload hours later is refused. */
                    && request.resource.data.t > request.time.toMillis() - 600000
                    && request.resource.data.t < request.time.toMillis() + 120000
                    && smallString('type', 20)
                    && smallString('path', 200)
                    && smallString('tool', 120));
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    /* ---------- admin-only collections ---------- */
    match /users/{id}    { allow read, write: if isAdmin() && freshAuth(5); }
    match /security/{id} { allow read, write: if isAdmin() && freshAuth(5); }
    match /audit/{id}    { allow read, write: if isAdmin() && freshAuth(5); }

    /* ---------- everything else is closed ---------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
